{
  "appId": "com.habittracker.app",
  "appName": "Habit Tracker",
  "webDir": "www",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#000000"
  },
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_habit",
      "iconColor": "#FFD60A"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    }
  }
}
